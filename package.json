{
	"name": "liferay-client-extensions",
	"version": "0.1.0",
	"description": "Build Liferay widgets with folders, not config. Generates client-extension.yaml from your file structure.",
	"keywords": [
		"client-extension",
		"custom-element",
		"liferay",
		"react",
		"vite"
	],
	"homepage": "https://github.com/duonghao/liferay-client-extensions#readme",
	"bugs": {
		"url": "https://github.com/duonghao/liferay-client-extensions/issues"
	},
	"license": "MIT",
	"author": "Hao Duong <hao.duong11@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/duonghao/liferay-client-extensions.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./vite": "./dist/vite.mjs",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"prepare": "husky",
		"prepublishOnly": "pnpm lint && pnpm test && pnpm build"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/react": "16.9.56",
		"@types/react-dom": "16.9.9",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"react": "16.14.0",
		"react-dom": "16.14.0",
		"tsdown": "^0.21.2",
		"typescript": "^6.0.3",
		"vite": "^6.4.4",
		"vitest": "^3.2.7"
	},
	"peerDependencies": {
		"react": ">=16.8",
		"react-dom": ">=16.8",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs,cjs}": [
			"oxfmt --no-error-on-unmatched-pattern",
			"oxlint --fix"
		],
		"*.{json,yaml,yml,md}": "oxfmt --no-error-on-unmatched-pattern"
	},
	"engines": {
		"node": ">=20"
	}
}
