{
	"name": "liferay-client-extensions",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"types": "./dist/index.d.mts",
	"exports": {
		".": "./dist/index.mjs",
		"./vite": "./dist/vite.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -b && tsdown",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"prepare": "husky"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@types/node": "^24",
		"@types/react": "16.9.56",
		"@types/react-dom": "16.9.9",
		"husky": "^9.1.7",
		"jsdom": "^30.1.2",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"react": "16.14.0",
		"react-dom": "16.14.0",
		"tsdown": "^0.21.2",
		"typescript": "^6.0.3",
		"vite": "^5.2.0",
		"vitest": "^3.2.7"
	},
	"peerDependencies": {
		"react": ">=16.8",
		"react-dom": ">=16.8",
		"vite": ">=5"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,mjs,cjs}": [
			"oxfmt --no-error-on-unmatched-pattern",
			"oxlint --fix"
		],
		"*.{json,yaml,yml,md}": "oxfmt --no-error-on-unmatched-pattern"
	}
}
